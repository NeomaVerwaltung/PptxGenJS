{
	"name": "pptxgenjs-workspace",
	"private": true,
	"description": "Workspace root for @neo-ma/pptxgenjs and its satellite packages - not published",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NeomaVerwaltung/PptxGenJS.git"
	},
	"bugs": {
		"url": "https://github.com/NeomaVerwaltung/PptxGenJS/issues"
	},
	"engines": {
		"node": ">=20"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "npm run build --workspaces --if-present",
		"dist": "npm run dist --workspaces --if-present",
		"lint": "npm run lint --workspaces --if-present",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"test": "npm run test --workspaces --if-present",
		"test:coverage": "npm run test:coverage --workspaces --if-present",
		"test:scripts": "node scripts/changelog.mjs --self-check",
		"test:office": "npm run test:office -w @neo-ma/pptxgenjs",
		"check": "npm run lint && npm run typecheck && npm run test:scripts && npm test",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs"
	},
	"devDependencies": {
		"@eslint/js": "^9.25.1",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^26.0.1",
		"@typescript-eslint/eslint-plugin": "^8.31.0",
		"@typescript-eslint/parser": "^8.31.0",
		"eslint": "^9.25.1",
		"fast-xml-parser": "^5.9.3",
		"gulp": "^5.0.0",
		"gulp-concat": "^2.6.1",
		"gulp-insert": "^0.5.0",
		"gulp-uglify": "^3.0.2",
		"image-dimensions": "^2.5.1",
		"rollup": "^4.24.2",
		"rollup-plugin-typescript2": "^0.37.0",
		"tslib": "^2.8.0",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.31.0",
		"vitepress": "^1.6.4"
	}
}
